{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "myadf123arup"
		},
		"ls_databricks_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'ls_databricks'"
		},
		"sql_LS_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'sql_LS'"
		},
		"LS_datalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://arupsa.dfs.core.windows.net/"
		},
		"ls_databricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0929-180945-11xxhqci"
		},
		"sales_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"sql_LS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "salesraw.database.windows.net"
		},
		"sql_LS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azuredb"
		},
		"sql_LS_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminarup"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "myadf123arup_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_databricks_accessToken": {
						"value": "[parameters('ls_databricks_accessToken')]"
					},
					"sql_LS_password": {
						"value": "[parameters('sql_LS_password')]"
					},
					"LS_datalake_properties_typeProperties_url": {
						"value": "[parameters('LS_datalake_properties_typeProperties_url')]"
					},
					"ls_databricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_databricks_properties_typeProperties_existingClusterId')]"
					},
					"sales_LS_properties_typeProperties_url": {
						"value": "[parameters('sales_LS_properties_typeProperties_url')]"
					},
					"sql_LS_properties_typeProperties_server": {
						"value": "[parameters('sql_LS_properties_typeProperties_server')]"
					},
					"sql_LS_properties_typeProperties_database": {
						"value": "[parameters('sql_LS_properties_typeProperties_database')]"
					},
					"sql_LS_properties_typeProperties_userName": {
						"value": "[parameters('sql_LS_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}