						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "sql_ds",
						"type": "DatasetReference",
						"parameters": {
							"table_name": "sources_cars_sales"
						}
					},
					"firstRowOnly": false
				}
